{
  "name": "telemarketing-core-engine",
  "version": "2.0.0",
  "description": "Phase 1+2 – High-throughput telemarketing communication engine: proxy circuit breaker, R2 media pipeline, Redis WebSocket adapter, BullMQ rate-limited queues",
  "author": "Core Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "build:frontend": "npm --prefix frontend run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "frontend": "npm --prefix frontend run dev",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:chaos": "jest test/chaos/chaos-socket.spec.ts --rootDir .",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "typeorm migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:run": "typeorm migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "typeorm migration:revert -d src/infrastructure/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.499.0",
    "@aws-sdk/lib-storage": "^3.499.0",
    "@aws-sdk/s3-request-presigner": "^3.499.0",
    "@nestjs-modules/ioredis": "^2.0.1",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-streams-adapter": "^0.2.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "baileys": "^6.7.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dockerode": "^4.0.2",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.2",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "langsmith": "^0.10.5",
    "mime-types": "^2.1.35",
    "nest-winston": "^1.9.4",
    "openai": "^7.23.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "pgvector": "^0.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socks": "^2.7.1",
    "socks-proxy-agent": "^8.0.2",
    "typeorm": "^0.3.20",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^3.3.29",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "@types/unzipper": "^0.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  }
}
