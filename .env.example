# ─────────────────────────────────────────────────────────────────────────────
#  WhatsApp Engine — Production Environment Configuration (.env.example)
#  Ranked A+ Grade: All secrets must be generated before deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
#  APPLICATION SETTINGS
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Frontend Dashboard Public URL (Used for root redirects & CORS)
FRONTEND_URL=https://yourdomain.com

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# WebSocket Origin for CSP Headers (e.g. wss://yourdomain.com)
WEBSOCKET_ORIGIN=wss://yourdomain.com

# ─────────────────────────────────────────────
#  SECURITY: DEV BYPASS & INITIAL CREDENTIALS
# ─────────────────────────────────────────────
# MUST BE FALSE IN PRODUCTION: Disables the public /api/v1/auth/dev-bypass-token
ALLOW_DEV_BYPASS=false

# Initial Super Admin credentials on clean database initialization
# Change this before first launch or update password via UI immediately after login.
SUPERADMIN_INITIAL_PASSWORD=ReplaceWithStrongAdminPassword123!

# JWT Secret for Auth Token Signing
# [CRITICAL SECURITY] Generate a unique 64-byte random hex key:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string_generate_via_node_crypto

# ─────────────────────────────────────────────
#  DATABASE CONFIGURATION (PostgreSQL Recommended for Production)
# ─────────────────────────────────────────────
# Set to 'postgres' for production multi-tenant scale; 'sqlite' for zero-dependency local dev
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=whatsapp_user
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=whatsapp_engine
DB_SSL=false
DB_SYNCHRONIZE=true

# If DB_TYPE=sqlite:
DB_PATH=./data/whatsapp.db

# ─────────────────────────────────────────────
#  REDIS CONFIGURATION (Cache + Queues + Streams)
# ─────────────────────────────────────────────
# [BLOCKER FIX] MUST BE 'false' IN PRODUCTION:
# Real Redis server is mandatory for BullMQ message queues, Redis Streams, and circuit breaker.
REDIS_MOCK=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ─────────────────────────────────────────────
#  SESSION ENCRYPTION (AES-256-CBC)
# ─────────────────────────────────────────────
# [CRITICAL SECURITY] Must be exactly 64 hex characters (32 bytes).
# Generate via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=replace_with_64_hex_chars_random_key_generate_via_node_crypto
SESSION_IV_LENGTH=16
SESSION_ALGORITHM=aes-256-cbc

# ─────────────────────────────────────────────
#  WHATSAPP ENGINE (BAILEYS) & SESSION STORAGE
# ─────────────────────────────────────────────
# Persistent storage directory for active WhatsApp credentials.
# In Docker, this is mounted to the whatsapp_sessions_data volume.
AUTH_TEMP_DIR=/app/data/sessions
AUTH_CLEANUP_INTERVAL_MS=300000
BAILEYS_LOG_LEVEL=silent
BAILEYS_BROWSER_NAME=Chrome
BAILEYS_BROWSER_VERSION=120.0.0

# ── Message Storage Privacy vs Multi-Device Access ──
# When true: chat history and messages are stored in the server database (PostgreSQL/SQLite)
# so chats sync across all browsers, admin computers, and mobile devices.
# When false: messages are held ONLY in the user's browser IndexedDB (zero server data).
STORE_MESSAGES_ON_SERVER=true

# ─────────────────────────────────────────────
#  HMAC WEBHOOK SECURITY (Meta Cloud API)
# ─────────────────────────────────────────────
# Your Meta App Secret (used to verify x-hub-signature-256 on incoming webhooks)
WEBHOOK_HMAC_SECRET=replace_with_your_actual_meta_app_secret
WEBHOOK_VERIFY_TOKEN=replace_with_your_meta_verify_token
WEBHOOK_SIGNATURE_HEADER=x-hub-signature-256

# ─────────────────────────────────────────────
#  CLOUDFLARE R2 ZERO-EGRESS MEDIA PIPELINE
# ─────────────────────────────────────────────
# If disabled, media files will be saved to local disk at ./data/media
# For production zero-egress cloud media storage, set Cloudflare R2 credentials:
R2_ACCOUNT_ID=disabled
R2_ACCESS_KEY_ID=disabled
R2_SECRET_ACCESS_KEY=disabled
R2_BUCKET_NAME=whatsapp-media
R2_PUBLIC_URL=https://pub-your-id.r2.dev
R2_PRESIGNED_URL_EXPIRY_SECONDS=3600
R2_MAX_FILE_SIZE_MB=100

# ─────────────────────────────────────────────
#  SOCKET.IO REAL-TIME GATEWAY
# ─────────────────────────────────────────────
SOCKET_IO_PORT=3001
SOCKET_IO_CORS_ORIGINS=https://yourdomain.com
SOCKET_IO_REDIS_ADAPTER=true
SOCKET_IO_PUBSUB_PREFIX=wa:pubsub

# ─────────────────────────────────────────────
#  REDIS STREAMS BUFFER
# ─────────────────────────────────────────────
REDIS_STREAM_KEY=wa:webhooks:incoming
REDIS_STREAM_MAX_LEN=100000

# ─────────────────────────────────────────────
#  RATE LIMITING & QUEUE CONTROLS
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MESSAGE_DELAY_MIN_MS=1000
MESSAGE_DELAY_MAX_MS=5000

BULLMQ_QUEUE_PREFIX=wa
BULLMQ_MAX_MSG_PER_SECOND=3
BULLMQ_CONCURRENCY=2
BULLMQ_MAX_RETRIES=5
BULLMQ_BACKOFF_DELAY_MS=5000
BULLMQ_STALLED_INTERVAL_MS=30000

# ─────────────────────────────────────────────
#  PROXY CIRCUIT BREAKER
# ─────────────────────────────────────────────
PROXY_DEFAULT_PROTOCOL=socks5
PROXY_ROTATION_ENABLED=true
PROXY_HEALTH_CHECK_INTERVAL_MS=30000
PROXY_MAX_RETRIES=3
PROXY_TIMEOUT_MS=10000
PROXY_CIRCUIT_BREAKER_THRESHOLD=3
PROXY_CIRCUIT_BREAKER_RESET_MS=60000
PROXY_CIRCUIT_BREAKER_HALF_OPEN_MAX=1
PROXY_CIRCUIT_BREAKER_REDIS_KEY_PREFIX=cb:proxy:

# ─────────────────────────────────────────────
#  CONTAINER ORCHESTRATION
# ─────────────────────────────────────────────
# Options: 'none' (standalone/monolithic), 'swarm' (Docker Swarm), 'coolify' (Coolify API)
# If using 'swarm', you MUST run "docker swarm init" on your host server.
ORCHESTRATOR_TYPE=none

# Docker host socket permissions (default host docker group ID: 999 or 998 on Linux)
DOCKER_GID=999
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=whatsapp-net
DOCKER_NETWORK_DRIVER=bridge
WA_ENGINE_IMAGE=whatsapp-engine:latest
CONTAINER_CPU_LIMIT=500000000
CONTAINER_MEM_LIMIT_MB=256
HEAL_STALL_THRESHOLD_MS=90000

# ─────────────────────────────────────────────
#  METRICS & MONITORING (Grafana & Prometheus)
# ─────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_strong_grafana_password
DEFAULT_TENANT_ID=default-tenant
